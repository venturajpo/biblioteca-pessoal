# Copie este arquivo para .env antes de subir o Compose:  cp .env.example .env
# O .env NÃO é versionado (ver .gitignore).

# Banco de dados
DB_NAME=biblioteca_pessoal
DB_USER=biblioteca
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-de-root
DB_PORT=3306

# API
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080

# Front-end
WEB_PORT=4200
WEB_ORIGIN=http://localhost:4200
